NODE_ENV=development
PORT=4173
APP_ORIGIN=http://localhost:4173
# Required in production. Local development uses embedded PostgreSQL when omitted.
# DATABASE_URL=postgresql://user:password@localhost:5432/goldswap
LOCAL_DATABASE_PATH=./data/goldswap.pglite
# Register this exact callback: http://localhost:4173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only for the one-time npm run admin:bootstrap command. Remove after use.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Required in production: 32 random bytes encoded as 64 hex characters.
# Keep stable and back it up separately; changing it makes old private uploads unreadable.
# UPLOAD_ENCRYPTION_KEY=

# Account email delivery. Keep false for local previews. Choose SMTP OR Resend.
MAIL_DELIVERY_ENABLED=false
MAIL_FROM=GoldSwap <app.goldswap@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=app.goldswap@gmail.com
# SMTP_PASSWORD= (Gmail app password, never your normal password)
# RESEND_API_KEY= (use a verified sender domain in MAIL_FROM)
# KYC_RETENTION_DAYS= (review a lawful retention policy before setting; minimum 30)
# Public SEO indexing stays off until production and reviewed public launch.
SEO_INDEXING_ENABLED=false
